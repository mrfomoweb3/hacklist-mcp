{
  "name": "hacklist-mcp",
  "version": "0.2.0",
  "description": "MCP server for HackList (hacklist.io): search AI & Web3 hackathons, grants and programs, see when they were listed, and rank the non-generic ones worth building for.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build",
    "check": "node dist/index.js --check",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy"
  },
  "keywords": [
    "mcp",
    "hackathon",
    "hacklist",
    "claude",
    "chatgpt",
    "web3",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3"
  },
  "type": "module",
  "bin": {
    "hacklist-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  }
}
